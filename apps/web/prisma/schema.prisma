generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Identidade leve por PIN: o convidado escolhe um nome e um PIN de 4 dígitos
// na primeira vez (guardados no localStorage do aparelho dele depois disso).
// Não é uma conta de verdade — só existe pra impedir que alguém publique ou
// comente usando o nome de outra pessoa. nameLower garante unicidade sem
// diferenciar maiúsculas/minúsculas.
model GuestAccount {
  id        String   @id @default(cuid())
  name      String
  nameLower String   @unique
  pinHash   String
  createdAt DateTime @default(now())
}

model Photo {
  id          String     @id @default(cuid())
  guestName   String
  caption     String
  imageUrl    String
  likeCount   Int        @default(0)
  challengeId String?
  challenge   Challenge? @relation(fields: [challengeId], references: [id])
  comments    Comment[]
  createdAt   DateTime   @default(now())

  @@index([createdAt])
}

model Challenge {
  id          String  @id @default(cuid())
  title       String
  description String
  photos      Photo[]
}

model Comment {
  id        String   @id @default(cuid())
  photoId   String
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  guestName String
  text      String
  createdAt DateTime @default(now())

  @@index([photoId, createdAt])
}
