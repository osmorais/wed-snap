generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Sem modelo de usuário: o convidado não faz login, só informa o nome no upload.
model Photo {
  id          String     @id @default(cuid())
  guestName   String
  caption     String
  imageUrl    String
  likeCount   Int        @default(0)
  challengeId String?
  challenge   Challenge? @relation(fields: [challengeId], references: [id])
  comments    Comment[]
  createdAt   DateTime   @default(now())

  @@index([createdAt])
}

model Challenge {
  id          String  @id @default(cuid())
  title       String
  description String
  photos      Photo[]
}

model Comment {
  id        String   @id @default(cuid())
  photoId   String
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  guestName String
  text      String
  createdAt DateTime @default(now())

  @@index([photoId, createdAt])
}
